        <mxCell id="header" value="Framebuffer mínimo: mapa de datos&#10;Propuesta de 3 bits/píxel (RGB111) para patrón de prueba y arquitectura inicial" style="rounded=0;whiteSpace=wrap;fillColor=#12243A;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=23;align=center;verticalAlign=middle;" vertex="1" parent="1">
