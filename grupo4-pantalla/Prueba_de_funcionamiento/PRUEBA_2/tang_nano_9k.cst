// =====================================================================
// tang_nano_9k.cst - Asignacion de pines para el controlador HUB75
// Placa: Sipeed Tang Nano 9K  (FPGA GW1NR-LV9QN88PC6/I5)
//
// Todos los pines usados estan en bancos de 3.3 V (banco 1 y banco 2).
// Se evitan: banco 3 (pines 79-88, 1.8 V), HDMI (69-75), ranura TF (36-39),
// botones (3, 4) y LEDs (10-16).
// IO_TYPE=LVCMOS33 se declara siempre: el valor por defecto de Gowin es 1.8 V.
// =====================================================================

// ---- Reloj de 27 MHz de la placa ----
IO_LOC  "clk" 52;
IO_PORT "clk" IO_TYPE=LVCMOS33 PULL_MODE=UP;

// ---- Boton S1 = reset (activo en bajo) ----
IO_LOC  "s1" 4;
IO_PORT "s1" IO_TYPE=LVCMOS33 PULL_MODE=UP;

// ---- HUB75: datos de color ----
IO_LOC  "r1" 25;  IO_PORT "r1" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_LOC  "g1" 26;  IO_PORT "g1" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_LOC  "b1" 27;  IO_PORT "b1" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_LOC  "r2" 28;  IO_PORT "r2" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_LOC  "g2" 29;  IO_PORT "g2" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;
IO_LOC  "b2" 30;  IO_PORT "b2" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;

// ---- HUB75: direccion de fila (A, B, C, D, E) ----
IO_LOC  "addr[0]" 33;  IO_PORT "addr[0]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;  // A
IO_LOC  "addr[1]" 34;  IO_PORT "addr[1]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;  // B
IO_LOC  "addr[2]" 40;  IO_PORT "addr[2]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;  // C
IO_LOC  "addr[3]" 35;  IO_PORT "addr[3]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;  // D
IO_LOC  "addr[4]" 41;  IO_PORT "addr[4]" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;  // E

// ---- HUB75: control ----
IO_LOC  "hub_clk" 42;  IO_PORT "hub_clk" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;  // CLK
IO_LOC  "hub_lat" 51;  IO_PORT "hub_lat" IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;  // LAT
IO_LOC  "hub_oe"  53;  IO_PORT "hub_oe"  IO_TYPE=LVCMOS33 PULL_MODE=NONE DRIVE=8;  // OE
