/><mxPoint x="630.0" y="363" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c50" value="1" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=10;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="613.0" y="376" width="24" height="14" as="geometry"/></mxCell><mxCell id="c51" value="spi_hold_n" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=12;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="686" y="360" width="220" height="20" as="geometry"/></mxCell><mxCell id="c52" value="" style="endArrow=none;html=1;rounded=0;strokeWidth=2;strokeColor=#222;strokeColor=#000000;strokeWidth=1;endArrow=classic;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="450.0" y="55" as="sourcePoint"/><mxPoint x="450.0" y="110" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c53" value="" style="endArrow=none;html=1;rounded=0;strokeWidth=2;strokeColor=#222;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="445.0" y="88" as="sourcePoint"/><mxPoint x="455.0" y="74" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c54" value="1" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=10;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="458.0" y="72" width="20" height="14" as="geometry"/></mxCell><mxCell id="c55" value="rst" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=12;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="420.0" y="34" width="60" height="18" as="geometry"/></mxCell><mxCell id="c56" value="" style="endArrow=none;html=1;rounded=0;strokeWidth=2;strokeColor=#222;strokeColor=#000000;strokeWidth=1;endArrow=classic;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="450.0" y="477" as="sourcePoint"/><mxPoint x="450.0" y="422" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c57" value="" style="endArrow=none;html=1;rounded=0;strokeWidth=2;strokeColor=#222;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="445.0" y="456" as="sourcePoint"/><mxPoint x="455.0" y="442" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c58" value="1" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=10;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="458.0" y="442" width="20" height="14" as="geometry"/></mxCell><mxCell id="c59" value="clk (50 MHz)" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=12;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="390.0" y="480" width="120" height="18" as="geometry"/></mxCell><mxCell id="c60" value="Entradas a la izquierda, salidas a la derecha, rst por arriba y clk por abajo. La marca diagonal indica el ancho en bits. A la izquierda está el bus del procesador (FemtoRV32) y a la derecha los pines que van a la memoria Flash de la tarjeta." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=11;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="40" y="517" width="900" height="50" as="geometry"/></mxCell><mxCell id="c61" value="&lt;b&gt;d_in, d_out&lt;/b&gt;: dato de 32 bits que escribe o lee el procesador.&lt;br&gt;&lt;b&gt;addr&lt;/b&gt;: elige el registro: CONTROL, ADDR, WDATA, RDATA, STATUS o CLK_DIV.&lt;br&gt;&lt;b&gt;cs, rd, wr&lt;/b&gt;: selección del periférico (0x42_0000), lectura y escritura.&lt;br&gt;&lt;b&gt;spi_sck, spi_mosi, spi_cs_n&lt;/b&gt;: reloj, dato hacia la Flash y selección de la Flash (activa en 0).&lt;br&gt;&lt;b&gt;spi_miso&lt;/b&gt;: dato que devuelve la Flash.&lt;br&gt;&lt;b&gt;spi_wp_n, spi_hold_n&lt;/b&gt;: se dejan fijas en 1 (sin protección ni pausa).&lt;br&gt;&lt;b&gt;rst&lt;/b&gt;: reset síncrono activo en alto." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=11;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="40" y="572" width="900" height="129" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p1" name="Caja negra I2C"><mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1000" pageHeight="760" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="&lt;b&gt;Caja negra del periférico I2C (perip_i2c)&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=15;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="40" y="15" width="800" height="24" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b style=&quot;font-size:15px&quot;&gt;perip_i2c&lt;/b&gt;&lt;br&gt;maestro I2C" style="rounded=0;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#000000;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="330" y="110" width="240" height="270" as="geometry"/></mxCell><mxCell id="c4" value="" style="endArrow=none;html=1;rounded=0;strokeWidth=2;strokeColor=#222;strokeColor=#000000;strokeWidth=1;endArrow=classic;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="220" y="160" as="sourcePoint"/><mxPoint x="330" y="160" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c5" value="" style="endArrow=none;html=1;rounded=0;strokeWidth=2;strokeColor=#222;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="270.0" y="167" as="sourcePoint"/><mxPoint x="280.0" y="153" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c6" value="32" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=10;fontColor=#000000;" vertex="1" parent="1"><mxGeometr