idth="24" height="14" as="geometry"/></mxCell><mxCell id="c35" value="i2c_sda" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=12;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="686" y="234" width="220" height="20" as="geometry"/></mxCell><mxCell id="c36" value="" style="endArrow=none;html=1;rounded=0;strokeWidth=2;strokeColor=#222;strokeColor=#000000;strokeWidth=1;endArrow=classic;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="450.0" y="55" as="sourcePoint"/><mxPoint x="450.0" y="110" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c37" value="" style="endArrow=none;html=1;rounded=0;strokeWidth=2;strokeColor=#222;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="445.0" y="88" as="sourcePoint"/><mxPoint x="455.0" y="74" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c38" value="1" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=10;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="458.0" y="72" width="20" height="14" as="geometry"/></mxCell><mxCell id="c39" value="rst" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=12;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="420.0" y="34" width="60" height="18" as="geometry"/></mxCell><mxCell id="c40" value="" style="endArrow=none;html=1;rounded=0;strokeWidth=2;strokeColor=#222;strokeColor=#000000;strokeWidth=1;endArrow=classic;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="450.0" y="435" as="sourcePoint"/><mxPoint x="450.0" y="380" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c41" value="" style="endArrow=none;html=1;rounded=0;strokeWidth=2;strokeColor=#222;strokeColor=#000000;strokeWidth=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="445.0" y="414" as="sourcePoint"/><mxPoint x="455.0" y="400" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c42" value="1" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=10;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="458.0" y="400" width="20" height="14" as="geometry"/></mxCell><mxCell id="c43" value="clk (50 MHz)" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=12;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="390.0" y="438" width="120" height="18" as="geometry"/></mxCell><mxCell id="c44" value="Entradas a la izquierda, salidas a la derecha, rst por arriba y clk por abajo. La marca diagonal indica el ancho en bits. i2c_scl e i2c_sda son bidireccionales (open-drain con pull-up de 4,7 kΩ) y van a la EEPROM 24LC256." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=11;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="40" y="475" width="900" height="50" as="geometry"/></mxCell><mxCell id="c45" value="&lt;b&gt;d_in, d_out&lt;/b&gt;: dato de 32 bits que escribe o lee el procesador.&lt;br&gt;&lt;b&gt;addr&lt;/b&gt;: elige el registro: CONTROL, TX_DATA, RX_DATA, STATUS o CLK_DIV.&lt;br&gt;&lt;b&gt;cs, rd, wr&lt;/b&gt;: selección del periférico (0x46_0000), lectura y escritura.&lt;br&gt;&lt;b&gt;i2c_scl&lt;/b&gt;: reloj I2C a 100 kHz. La FPGA solo la baja a 0 o la suelta.&lt;br&gt;&lt;b&gt;i2c_sda&lt;/b&gt;: datos y ACK en la misma línea. La FPGA solo la baja a 0 o la suelta.&lt;br&gt;&lt;b&gt;rst&lt;/b&gt;: reset síncrono activo en alto." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;strokeColor=none;fillColor=none;fontSize=11;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="40" y="530" width="900" height="112" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
