// prueba_grupo1_9k.cst
// Pines de la prueba en placa (fpga/prueba_grupo1_9k.v) en la Tang Nano 9K
// (GW1NR-LV9QN88PC6/I5). Reloj, botones, LEDs y UART son los de la tarjeta
// (los mismos que usa el grupo 6); la Flash es la P25Q32 de la tarjeta.
//
// En Gowin IDE: Project > Configuration > Place & Route > Dual-Purpose Pin >
// "Use MSPI as regular IO" (los pines 59 a 62 de la Flash son de doble uso).
//
// Los pines 3 a 20 y 79 a 88 estan en el banco de 1,8 V; la EEPROM va en
// pines del banco de 3,3 V.

// ---- Reloj de 27 MHz ----
IO_LOC  "clk" 52;
IO_PORT "clk" IO_TYPE=LVCMOS33 PULL_MODE=UP;

// ---- Botones S1 y S2 (activos en 0) ----
IO_LOC  "btn_rst_n" 4;
IO_PORT "btn_rst_n" IO_TYPE=LVCMOS18 PULL_MODE=UP;
IO_LOC  "btn_run_n" 3;
IO_PORT "btn_run_n" IO_TYPE=LVCMOS18 PULL_MODE=UP;

// ---- LEDs 0 y 1 de la tarjeta (encienden con 0) ----
IO_LOC  "led[0]" 10;
IO_PORT "led[0]" IO_TYPE=LVCMOS18 PULL_MODE=UP DRIVE=8;
IO_LOC  "led[1]" 11;
IO_PORT "led[1]" IO_TYPE=LVCMOS18 PULL_MODE=UP DRIVE=8;

// ---- UART hacia el PC (por el USB de la tarjeta) ----
IO_LOC  "uart_tx" 17;
IO_PORT "uart_tx" IO_TYPE=LVCMOS33 PULL_MODE=UP;

// ---- Flash SPI de la tarjeta (P25Q32, pines MSPI) ----
IO_LOC  "spi_sck" 59;
IO_PORT "spi_sck" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC  "spi_cs_n" 60;
IO_PORT "spi_cs_n" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_LOC  "spi_mosi" 61;
IO_PORT "spi_mosi" IO_TYPE=LVCMOS33 PULL_MODE=NONE;
IO_LOC  "spi_miso" 62;
IO_PORT "spi_miso" IO_TYPE=LVCMOS33 PULL_MODE=UP;

// ---- EEPROM I2C (drenador abierto, pull-ups de 4,7 kOhm a 3,3 V) ----
IO_LOC  "i2c_scl" 31;
IO_PORT "i2c_scl" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_LOC  "i2c_sda" 32;
IO_PORT "i2c_sda" IO_TYPE=LVCMOS33 PULL_MODE=UP;
